# ─────────────────────────────────────────────────────────────
#  PETclub App — Frontend Environment Variables
#  Copy to .env.local for local dev. Set in Vercel dashboard for production.
# ─────────────────────────────────────────────────────────────

# Backend API URL (set in Vercel as VITE_API_URL)
VITE_API_URL=https://api.mypetclub.app/api

# Support email shown in error messages
VITE_SUPPORT_EMAIL=support@mypetclub.app

# ── Firebase Cloud Messaging (Push Notifications) ──────────
# Get these from: console.firebase.google.com → Your Project → Project Settings → General → Your apps
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef...

# Get from: Firebase Console → Project Settings → Cloud Messaging → Web Push Certificates → Key pair
VITE_FIREBASE_VAPID_KEY=BNxxxxxxxx...

# ── Mapbox (Address Autocomplete) ────────────────────────
# Powers the address autocomplete in signup + booking forms
# Get from: account.mapbox.com → Tokens → Create a token (public scopes only)
# Free tier: 100,000 requests/month — sufficient for early stage
VITE_MAPBOX_TOKEN=pk.eyJ1Ijoi...

# ── Legal page URLs ───────────────────────────────────────
# Shown in the login/signup footer. Defaults to mypetclub.app if not set.
VITE_TERMS_URL=https://mypetclub.app/terms.html
VITE_PRIVACY_URL=https://mypetclub.app/privacy.html

# ── App URL (used for Razorpay logo, OG tags, etc.) ─────
VITE_APP_URL=https://app.mypetclub.app
